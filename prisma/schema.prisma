generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum InvitationStatus {
    pending
    accepted
    rejected
    canceled
}

enum MemberRole {
    owner
    admin
    member
}

enum UserRole {
    user
    admin
}

model Account {
    id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    accountId             String    @map("account_id") @db.Text
    providerId            String    @map("provider_id") @db.Text
    userId                String    @map("user_id") @db.Uuid
    accessToken           String?   @map("access_token") @db.Text
    refreshToken          String?   @map("refresh_token") @db.Text
    idToken               String?   @map("id_token") @db.Text
    expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)
    password              String?   @db.Text
    accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
    refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
    scope                 String?   @db.Text
    createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([providerId, accountId], map: "account_provider_account_idx")
    @@index([userId], map: "account_user_id_idx")
    @@map("account")
}

model Invitation {
    id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    organizationId String           @map("organization_id") @db.Uuid
    email          String           @db.Text
    role           MemberRole       @default(member)
    status         InvitationStatus @default(pending)
    expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
    inviterId      String           @map("inviter_id") @db.Uuid
    createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

    @@index([organizationId], map: "invitation_organization_id_idx")
    @@index([email], map: "invitation_email_idx")
    @@index([status], map: "invitation_status_idx")
    @@index([expiresAt], map: "invitation_expires_at_idx")
    @@index([inviterId], map: "invitation_inviter_id_idx")
    @@map("invitation")
}

model Member {
    id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    organizationId String     @map("organization_id") @db.Uuid
    userId         String     @map("user_id") @db.Uuid
    role           MemberRole @default(member)
    createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, organizationId], map: "member_user_org_idx")
    @@index([organizationId], map: "member_organization_id_idx")
    @@index([userId], map: "member_user_id_idx")
    @@index([role], map: "member_role_idx")
    @@map("member")
}

model Organization {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String   @db.Text
    slug      String?  @db.Text
    logo      String?  @db.Text
    metadata  String?  @db.Text
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    members     Member[]
    invitations Invitation[]
    rooms       Room[]
    students    Student[]
    feePayments FeePayment[]
    foodMenus   FoodMenu[]

    @@unique([slug], map: "organization_slug_idx")
    @@index([name], map: "organization_name_idx")
    @@map("organization")
}

model Session {
    id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
    ipAddress            String?  @map("ip_address") @db.Text
    userAgent            String?  @map("user_agent") @db.Text
    userId               String   @map("user_id") @db.Uuid
    impersonatedBy       String?  @map("impersonated_by") @db.Uuid
    activeOrganizationId String?  @map("active_organization_id") @db.Uuid
    token                String   @db.Text
    createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    user               User  @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
    impersonatedByUser User? @relation("SessionImpersonatedBy", fields: [impersonatedBy], references: [id])

    @@unique([token], map: "session_token_idx")
    @@index([userId], map: "session_user_id_idx")
    @@index([expiresAt], map: "session_expires_at_idx")
    @@index([activeOrganizationId], map: "session_active_organization_id_idx")
    @@map("session")
}

model TwoFactor {
    id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    secret      String   @db.Text
    backupCodes String   @map("backup_codes") @db.Text
    userId      String   @map("user_id") @db.Uuid
    createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId], map: "two_factor_user_id_idx")
    @@map("two_factor")
}

model User {
    id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name               String
    email              String    @unique(map: "user_email_unique") @db.Text
    emailVerified      Boolean   @default(false) @map("email_verified")
    image              String?   @db.Text
    username           String?   @unique(map: "user_username_unique") @db.Text
    role               UserRole  @default(user)
    banned             Boolean?  @default(false)
    banReason          String?   @map("ban_reason") @db.Text
    banExpires         DateTime? @map("ban_expires") @db.Timestamptz(6)
    onboardingComplete Boolean   @default(false) @map("onboarding_complete")
    twoFactorEnabled   Boolean?  @default(false) @map("two_factor_enabled")
    createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    accounts             Account[]
    sessions             Session[]    @relation("SessionUser")
    impersonatedSessions Session[]    @relation("SessionImpersonatedBy")
    memberships          Member[]
    invitations          Invitation[] @relation("InvitationInviter")
    twoFactors           TwoFactor[]

    @@index([role], map: "user_role_idx")
    @@index([banned], map: "user_banned_idx")
    @@map("user")
}

model Verification {
    id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    identifier String    @db.Text
    value      String    @db.Text
    expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
    createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    @@index([identifier], map: "verification_identifier_idx")
    @@index([value], map: "verification_value_idx")
    @@index([expiresAt], map: "verification_expires_at_idx")
    @@map("verification")
}

model Room {
    id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    organizationId String @map("organization_id") @db.Uuid
    name           String @db.Text
    seatType       String @map("seat_type") @db.Text
    floor          Int

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    students     Student[]

    @@index([organizationId], map: "room_organization_id_idx")
    @@index([floor], map: "room_floor_idx")
    @@index([organizationId, floor], map: "room_org_floor_idx")
    @@map("room")
}

model Student {
    id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    organizationId String  @map("organization_id") @db.Uuid
    roomId         String  @map("room_id") @db.Uuid
    name           String  @db.Text
    fatherName     String  @map("father_name") @db.Text
    nic            String  @db.Text
    phone          String  @db.Text
    guardianPhone  String  @map("guardian_phone") @db.Text
    address        String  @db.Text
    fee            Int     @default(0)
    remainingFee   Int     @default(0) @map("remaining_fee")
    picture        String? @db.Text

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
    feePayments  FeePayment[]

    @@index([organizationId], map: "student_organization_id_idx")
    @@index([roomId], map: "student_room_id_idx")
    @@index([nic], map: "student_nic_idx")
    @@index([organizationId, roomId], map: "student_org_room_idx")
    @@map("student")
}

model FeePayment {
    id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    organizationId String  @map("organization_id") @db.Uuid
    studentId      String  @map("student_id") @db.Uuid
    amount         Int
    month          Int
    year           Int
    notes          String? @db.Text

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@unique([studentId, month, year], map: "fee_payment_student_month_year_idx")
    @@index([organizationId], map: "fee_payment_organization_id_idx")
    @@index([studentId], map: "fee_payment_student_id_idx")
    @@index([organizationId, month, year], map: "fee_payment_org_month_year_idx")
    @@map("fee_payment")
}

model FoodMenu {
    id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    organizationId String   @map("organization_id") @db.Uuid
    mealType       String   @map("meal_type") @db.Text
    items          String   @db.Text
    startTime      String   @map("start_time") @db.Text
    endTime        String   @map("end_time") @db.Text

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@unique([organizationId, mealType], map: "food_menu_org_meal_type_idx")
    @@index([organizationId], map: "food_menu_organization_id_idx")
    @@map("food_menu")
}
